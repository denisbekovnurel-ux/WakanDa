# Переменные для docker compose (см. docker-compose.yml).
# Скопируйте этот файл в .env (он в git не попадёт) и заполните значения.

# Обязательно: пароль администратора. Смените на свой длинный пароль.
WAKANDA_ADMIN_PASS=change-me

# По желанию: фиксированные ключи Web Push (VAPID). Если оставить пустыми,
# сервер сгенерирует их сам и сохранит в томе данных.
# Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
# WAKANDA_VAPID_PUBLIC=
# WAKANDA_VAPID_PRIVATE=
# WAKANDA_VAPID_SUBJECT=mailto:you@example.com
