# Переменные для docker compose (см. docker-compose.yml).
# Скопируйте этот файл в .env (он в git не попадёт) и заполните значения.

# Обязательно: пароль администратора. Смените на свой длинный пароль.
WAKANDA_ADMIN_PASS=change-me

# По желанию: готовый образ из GitHub Actions вместо локальной сборки.
# WAKANDA_IMAGE=ghcr.io/denisbekovnurel-ux/wakanda:latest

# По желанию: выключить Swagger по адресу /api/docs (по умолчанию включён).
# WAKANDA_SWAGGER=0

# По желанию: фиксированные ключи Web Push (VAPID). Если оставить пустыми,
# сервер сгенерирует их сам и сохранит в томе данных.
# Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
# WAKANDA_VAPID_PUBLIC=
# WAKANDA_VAPID_PRIVATE=
# WAKANDA_VAPID_SUBJECT=mailto:you@example.com

# По желанию: уведомления в Telegram. Токен выдаёт @BotFather.
# Webhook — публичный HTTPS-адрес; без него бот работает через long polling.
# WAKANDA_TELEGRAM_BOT_TOKEN=
# WAKANDA_TELEGRAM_BOT_USERNAME=
# WAKANDA_TELEGRAM_WEBHOOK_URL=
# WAKANDA_TELEGRAM_WEBHOOK_SECRET=

# Если перед контейнером стоит reverse proxy, укажите число хопов (обычно 1)
# или подсети через запятую. Иначе rate limit будет видеть IP прокси.
# WAKANDA_TRUST_PROXY=1
