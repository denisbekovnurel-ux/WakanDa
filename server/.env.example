# Настройки сервера WakanDa.
# Скопируй этот файл в server/.env (он не попадёт в git) и при необходимости заполни.
#
# Администратор ВСЕГДА один и фиксирован. Значения ниже позволяют только
# ОСОЗНАННО переопределить логин/пароль администратора. Сервер применяет их
# при каждом запуске: если задать WAKANDA_ADMIN_PASS и перезапустить сервер,
# пароль администратора станет таким. Без WAKANDA_ADMIN_PASS пароль
# генерируется случайно и записывается в server/data/admin-credentials.txt.
#
# Второго администратора создать нельзя: регистрация всегда создаёт обычных
# пользователей, а лишние «админы» автоматически понижаются при запуске.

# WAKANDA_ADMIN_USER=waka_admin
# WAKANDA_ADMIN_PASS=waka_pass_47906

# Порт API (по умолчанию 3001)
# PORT=3001

# Лимит размера JSON-тела запроса (по умолчанию 2mb).
# WAKANDA_BODY_LIMIT=2mb

# Разрешённые домены для CORS через запятую. Если не задано, CORS выключен:
# браузерные cross-origin запросы не проходят, разрешён только same-origin
# (фронт и API на одном домене — рекомендуемый вариант).
# Пример для фронта на другом домене:
# WAKANDA_CORS_ORIGINS=https://my-frontend.example.com
#
# Сколько прокси-хопов доверять (X-Forwarded-For). По умолчанию — нисколько.
# За reverse proxy задайте 1, loopback или список подсетей, иначе rate limit
# увидит IP прокси и ограничения будут общими для всех.
# WAKANDA_TRUST_PROXY=1
#
# На проде с HTTPS: включает HSTS и upgrade-insecure-requests в CSP.
# NODE_ENV=production

# Каталог с базой SQLite (по умолчанию server/data).
# WAKANDA_DATA_DIR=./data

# Фоновые Web Push-уведомления (VAPID). Если ключи не заданы, сервер сгенерирует
# их при первом запуске и сохранит в базе — подписки продолжат работать между
# перезапусками. Задавать свои ключи имеет смысл, чтобы они не менялись между
# окружениями. Subject — почта администратора или URL сайта.
# WAKANDA_VAPID_PUBLIC=
# WAKANDA_VAPID_PRIVATE=
# WAKANDA_VAPID_SUBJECT=mailto:admin@example.com

# Уведомления и напоминания в Telegram. Токен выдаёт @BotFather («Create new
# bot» → API Token). Без токена интеграция выключена, остальные настройки не нужны.
# WAKANDA_TELEGRAM_BOT_TOKEN=123456789:AA...
#
# Имя бота нужно для ссылки привязки (https://t.me/<bot>?start=<код>). Можно не
# задавать: сервер запросит его у Telegram через getMe при запуске.
# WAKANDA_TELEGRAM_BOT_USERNAME=wakanda_demo_bot
#
# Как бот получает ответы пользователей. Telegram умеет присылать сообщения сам
# (webhook) — для этого нужен публичный HTTPS-адрес сайта или API, можно указать
# и базовый адрес, и полный URL:
# WAKANDA_TELEGRAM_WEBHOOK_URL=https://wakanda.example.com
#
# Секрет, который Telegram возвращает в заголовке X-Telegram-Bot-Api-Secret-Token.
# Без него вебхук не регистрируется (любой смог бы прислать чужой код привязки),
# и сервер переходит на long polling. Любая длинная случайная строка, например:
# openssl rand -hex 32
# WAKANDA_TELEGRAM_WEBHOOK_SECRET=
#
# Long polling работает без публичного адреса — удобно локально, но требует,
# чтобы сервер был запущен постоянно. Если Telegram недоступен под другим
# доменом (прокси, self-hosted Bot API), укажите базу:
# WAKANDA_TELEGRAM_API_BASE=https://api.telegram.org

# Отключить раздачу собранного фронтенда с API-сервера (по умолчанию включена).
# WAKANDA_SERVE_STATIC=0

# Уровень JSON-логов: fatal, error, warn, info, debug, trace или silent.
# WAKANDA_LOG_LEVEL=info

# Метка релиза в каждой записи лога (например, git SHA или версия образа).
# WAKANDA_RELEASE=
