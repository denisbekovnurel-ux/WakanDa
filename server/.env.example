# Настройки сервера WakanDa.
# Скопируй этот файл в server/.env (он не попадёт в git) и при необходимости заполни.
#
# Администратор ВСЕГДА один и фиксирован. Значения ниже позволяют только
# ОСОЗНАННО переопределить логин/пароль администратора. Сервер применяет их
# при каждом запуске: если задать WAKANDA_ADMIN_PASS и перезапустить сервер,
# пароль администратора станет таким. Без этих переменных используются
# значения по умолчанию из server/src/auth/admin.config.ts.
#
# Второго администратора создать нельзя: регистрация всегда создаёт обычных
# пользователей, а лишние «админы» автоматически понижаются при запуске.

# WAKANDA_ADMIN_USER=waka_admin
# WAKANDA_ADMIN_PASS=твой-пароль

# Порт API (по умолчанию 3001)
# PORT=3001

# Лимит размера JSON-тела запроса (по умолчанию 2mb).
# WAKANDA_BODY_LIMIT=2mb

# Разрешённые домены для CORS через запятую. Если не задано — разрешены все (*).
# Пример для фронта на другом домене:
# WAKANDA_CORS_ORIGINS=https://my-frontend.example.com

# Каталог с базой SQLite (по умолчанию server/data).
# WAKANDA_DATA_DIR=./data
