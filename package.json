{
  "name": "wakanda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm run dev --prefix server\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --prefix server",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "npm test --prefix server",
    "test:e2e": "npm run test:e2e --prefix server",
    "typecheck": "npm run typecheck --prefix server",
    "check": "npm run lint && npm run test && npm run typecheck && npm run build",
    "postbuild": "node scripts/inject-sw-version.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
